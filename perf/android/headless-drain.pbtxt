# Perfetto config for measuring one headless detection run (plan §3.1, task T9.2).
# Captures CPU scheduling, app memory counters and the app's own trace sections.
duration_ms: 60000
buffers { size_kb: 65536 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "sched/sched_wakeup"
      atrace_categories: "am"
      atrace_categories: "dalvik"
      atrace_apps: "app.budgetbrain.mobile"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 250 }
  }
}
data_sources {
  config {
    name: "android.packages_list"
  }
}
