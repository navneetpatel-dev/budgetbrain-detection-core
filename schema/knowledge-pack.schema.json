{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/navneetpatel-dev/budgetbrain-detection-core/schema/knowledge-pack.schema.json",
  "title": "BudgetBrain detection knowledge pack",
  "description": "Signed, versioned data that drives transaction detection: institutions, senders, lexicons, templates, merchants, currencies, rails, taxonomy and kill switches. Cross-references (e.g. sender → institution) are checked by validateKnowledgePack() in src/pack/validate.ts.",
  "oneOf": [
    {
      "$ref": "#/$defs/signedPack"
    },
    {
      "$ref": "#/$defs/pack"
    }
  ],
  "$defs": {
    "signedPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/pack"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "keyId",
            "value"
          ],
          "properties": {
            "alg": {
              "const": "Ed25519"
            },
            "keyId": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]+={0,2}$"
            }
          }
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "institutions",
        "senders",
        "lexicons",
        "templates",
        "merchants",
        "merchantAliases",
        "currencies",
        "paymentRails",
        "taxonomy",
        "mcc",
        "killSwitches"
      ],
      "properties": {
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "packVersion",
            "country",
            "generatedAt",
            "minCoreVersion"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "packVersion": {
              "type": "integer",
              "minimum": 1
            },
            "country": {
              "type": "string",
              "pattern": "^(GLOBAL|[A-Z]{2})$"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "minCoreVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
            },
            "baseVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "institutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "displayName",
              "country",
              "type",
              "verified"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "type": {
                "enum": [
                  "bank",
                  "card_issuer",
                  "wallet",
                  "nbfc",
                  "payment_app",
                  "broker",
                  "credit_union"
                ]
              },
              "bic": {
                "type": "string",
                "pattern": "^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$"
              },
              "codes": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        },
        "senders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institutionId",
              "channel",
              "match",
              "key"
            ],
            "properties": {
              "institutionId": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "enum": [
                  "sms",
                  "email",
                  "notification"
                ]
              },
              "match": {
                "enum": [
                  "header",
                  "exact",
                  "domain"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "lexicons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "class",
              "phrases"
            ],
            "properties": {
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "class": {
                "enum": [
                  "debit_verbs",
                  "credit_verbs",
                  "refund",
                  "reversal",
                  "cashback",
                  "transfer",
                  "self_transfer",
                  "bill_payment",
                  "failed",
                  "otp_markers",
                  "promo_markers",
                  "non_transaction_notice",
                  "future_or_request",
                  "balance",
                  "limit",
                  "safety_footer",
                  "account_markers",
                  "reference_markers"
                ]
              },
              "phrases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "institutionId",
              "version",
              "language",
              "skeleton",
              "fields",
              "direction",
              "transactionType"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "institutionId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "skeleton": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "enum": [
                    "amount",
                    "balance",
                    "limit",
                    "date",
                    "time",
                    "account",
                    "reference",
                    "merchant",
                    "counterparty",
                    "ignore"
                  ]
                },
                "contains": {
                  "const": "amount"
                }
              },
              "direction": {
                "enum": [
                  "DEBIT",
                  "CREDIT"
                ]
              },
              "transactionType": {
                "enum": [
                  "expense",
                  "income",
                  "refund",
                  "transfer"
                ]
              },
              "subtype": {
                "enum": [
                  "cashback",
                  "reversal",
                  "card_bill",
                  "p2p",
                  "self_transfer",
                  "wallet_topup"
                ]
              },
              "paymentMethod": {
                "enum": [
                  "card",
                  "upi",
                  "bank_transfer",
                  "wallet",
                  "cash",
                  "other"
                ]
              },
              "dateOrder": {
                "enum": [
                  "DMY",
                  "MDY",
                  "YMD"
                ]
              }
            }
          }
        },
        "merchants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "country",
              "taxonomyCode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                ]
              },
              "wikidataId": {
                "type": "string",
                "pattern": "^Q\\d+$"
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "taxonomyCode": {
                "type": "string",
                "minLength": 1
              },
              "mcc": {
                "type": "string",
                "pattern": "^\\d{4}$"
              }
            }
          }
        },
        "merchantAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "merchantId",
              "alias"
            ],
            "properties": {
              "merchantId": {
                "type": "string",
                "minLength": 1
              },
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            }
          }
        },
        "currencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "minorUnits",
              "symbols",
              "decimalSeparator",
              "groupSeparator",
              "grouping"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "minorUnits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ambiguousSymbols": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "decimalSeparator": {
                "enum": [
                  ".",
                  ","
                ]
              },
              "groupSeparator": {
                "enum": [
                  ",",
                  ".",
                  " ",
                  "'",
                  ""
                ]
              },
              "grouping": {
                "enum": [
                  "standard",
                  "indian"
                ]
              }
            }
          }
        },
        "paymentRails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "paymentMethod",
              "keywords"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "paymentMethod": {
                "enum": [
                  "card",
                  "upi",
                  "bank_transfer",
                  "wallet",
                  "cash",
                  "other"
                ]
              },
              "countries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "taxonomy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mcc": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mcc",
              "taxonomyCode"
            ],
            "properties": {
              "mcc": {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              "taxonomyCode": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "killSwitches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "key",
              "action"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "institution",
                  "template",
                  "country",
                  "pack",
                  "app_version"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "disable_auto_create",
                  "disable_detection"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
