{
  "name": "@budgetbrain/detection-core",
  "version": "0.1.0",
  "description": "Platform-independent transaction detection pipeline shared by BudgetBrain mobile, backend and web.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./corpus": {
      "import": {
        "types": "./dist/corpus/index.d.ts",
        "default": "./dist/corpus/index.js"
      },
      "require": {
        "types": "./dist/corpus/index.d.cts",
        "default": "./dist/corpus/index.cjs"
      }
    },
    "./bench": {
      "import": {
        "types": "./dist/bench/index.d.ts",
        "default": "./dist/bench/index.js"
      },
      "require": {
        "types": "./dist/bench/index.d.cts",
        "default": "./dist/bench/index.cjs"
      }
    },
    "./schema/knowledge-pack.schema.json": "./schema/knowledge-pack.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "tsx scripts/run-corpus.ts",
    "pack:validate": "tsx scripts/validate-pack.ts packs/sample/IN.pack.signed.json",
    "pack:sign": "tsx scripts/sign-pack.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run corpus && npm run pack:validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-regexp": "^2.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  }
}
